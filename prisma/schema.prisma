// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RealEstateAgency {
  id                    String @db.Uuid                @id @default(uuid())
  clerkOrganizationId   String @unique
  name                  String
  slug                  String?
  imageUrl              String?
  legalName             String?
  taxId                 String?
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  customDomain          String?
  demandEmbedPublicKeyHash String?
  demandEmbedPublicKeyHint String?
  demandEmbedKeyRotatedAt DateTime?
  billingEmail          String?
  billingAddress        Json?
  stripeCustomerId      String?                @unique
  billingStatus         BillingAgencyStatus    @default(PENDING_ACTIVATION)
  billingCollectionMode BillingCollectionMode  @default(AUTOMATIC)
  graceUntil            DateTime?
  suspendedAt           DateTime?
  cancelledAt           DateTime?
  dataRetentionUntil    DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  memberships           AgencyMembership[]
  branches              Branch[]
  teams                 Team[]
  teamTerritories       TeamTerritory[]
  properties            Property[]
  demands               Demand[]
  demandInteractions    DemandInteraction[]
  demandImportJobs      DemandImportJob[]
  tasks                 Task[]
  visits                Visit[]
  visitConfirmationTokens VisitConfirmationToken[]
  calendarConnections   CalendarConnection[]
  calendarSyncPreferences CalendarSyncPreference[]
  calendarSyncCheckpoints CalendarSyncCheckpoint[]
  owners                Owner[]
  captureOpportunities  CaptureOpportunity[]
  marketListings        MarketListing[]
  propertyPhotos        PropertyPhoto[]
  propertyDocuments     PropertyDocument[]
  propertyImportJobs    PropertyImportJob[]
  propertyCommissionSettings PropertyCommissionSetting[]
  agencyCommissionSetting AgencyCommissionSetting?
  commissions          Commission[]
  liquidationRuns      LiquidationRun[]
  auditLogs             AuditLog[]
  subscriptions         AgencySubscription[]
  usageCounters         AgencyUsageCounter[]
  usageEvents           AgencyUsageEvent[]
  billingInvoices       BillingInvoice[]
  paymentMethods        BillingPaymentMethod[]
  pendingChanges        BillingPendingChange[]
  appliedCoupons        AgencyCoupon[]
  billingAuditLogs      BillingAuditLog[]
  webhookEvents         BillingWebhookEvent[]
  featureFlags          AgencyFeatureFlag[]
  notifications         Notification[]
  notificationPreferences NotificationPreference[]
  notificationDndWindows NotificationDndWindow[]
  agencyEmailTemplateOverrides AgencyEmailTemplateOverride[]
  emailDeliveries      EmailDelivery[]
  opsAlerts            OpsAlert[]
}

model AgencyMembership {
  id                String           @id @default(uuid())
  agencyId          String
  clerkUserId       String
  clerkMembershipId String?          @unique
  role              String
  status            AgencyMembershipStatus @default(ACTIVE)
  branchId          String?
  teamId            String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  agency            RealEstateAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  branch            Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  team              Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([agencyId, clerkUserId])
  @@index([agencyId, status])
  @@index([branchId])
  @@index([teamId])
  @@index([clerkUserId])
}

enum AgencyMembershipStatus {
  ACTIVE
  SUSPENDED
}

model Branch {
  id          String           @id @default(uuid())
  agencyId    String
  name        String
  code        String?
  city        String?
  address     String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  agency      RealEstateAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  memberships AgencyMembership[]
  teams       Team[]

  @@unique([agencyId, name])
  @@unique([agencyId, code])
  @@index([agencyId, isActive])
}

model Team {
  id          String           @id @default(uuid())
  agencyId    String
  branchId    String?
  name        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  agency      RealEstateAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  branch      Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  memberships AgencyMembership[]
  territories TeamTerritory[]

  @@unique([agencyId, name])
  @@index([agencyId, isActive])
  @@index([branchId])
}

model TeamTerritory {
  id        String           @id @default(uuid())
  agencyId  String
  teamId    String
  cityCode  String
  cityName  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  agency    RealEstateAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, cityCode])
  @@index([agencyId, cityCode])
}

model AgencyFeatureFlag {
  id              String           @id @default(uuid())
  agencyId        String
  moduleCode      String
  enabled         Boolean          @default(true)
  reason          String?
  metadata        Json?
  updatedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  agency          RealEstateAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, moduleCode])
  @@index([agencyId, enabled])
}

enum BillingAgencyStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum BillingCollectionMode {
  AUTOMATIC
  MANUAL_INVOICE
}

enum SubscriptionLifecycleStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PlanCatalogStatus {
  ACTIVE
  ARCHIVED
}

enum LimitBehavior {
  HARD_CAP
  SOFT_CAP_OVERAGE
}

enum SubscriptionCityStatus {
  ACTIVE
  PENDING_ACTIVATION
  PENDING_DEACTIVATION
  INACTIVE
}

enum ChangeApplyMode {
  IMMEDIATE
  NEXT_CYCLE
}

enum SubscriptionChangeType {
  PLAN
  PERIOD
  CITIES
  LIMITS
  OVERAGE_PRICING
  COUPON
  CANCELLATION
}

enum PendingChangeStatus {
  PENDING
  APPLIED
  CANCELLED
  REPLACED
  FAILED
}

enum BillingInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum BillingInvoiceLineType {
  PLAN_RECURRING
  CITY_ADDON_RECURRING
  OVERAGE
  DISCOUNT
  MANUAL_ADJUSTMENT
  TAX
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponDuration {
  ONCE
  REPEATING
  FOREVER
}

enum AgencyCouponStatus {
  ACTIVE
  EXPIRED
  REMOVED
}

enum BillingPaymentMethodStatus {
  ACTIVE
  EXPIRED
  DETACHED
}

enum BillingWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum BillingAuditActorType {
  SYSTEM
  ADMIN
  CLIENT
}

enum NotificationEventType {
  DEMAND_CREATED
  DEMAND_STATUS_CHANGED
  PROPERTY_CREATED
  PROPERTY_STATUS_CHANGED
  WELCOME
  TASK_ASSIGNED
  VISIT_CONFIRMED
  VISIT_REMINDER
  BILLING_PAYMENT_SUCCEEDED
  BILLING_PAYMENT_FAILED
  BILLING_CHANGE_SCHEDULED
  BILLING_CHANGE_APPLIED
  BILLING_SUSPENDED
  BILLING_OVERAGE_CAP_REACHED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum OpsAlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
}

enum OpsAlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

enum ContactChannel {
  WHATSAPP
  SMS
  EMAIL
  CALL
}

enum SuppressionSource {
  USER_OPTOUT
  LEGAL
  MANUAL_OPS
  BOUNCE
  COMPLAINT
}

model BillingPlan {
  id                String                    @id @default(uuid())
  code              String                    @unique
  name              String
  description       String?
  status            PlanCatalogStatus         @default(ACTIVE)
  isFreeTier        Boolean                   @default(false)
  defaultOverageCap Decimal?                  @db.Decimal(14, 2)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  prices            BillingPlanPrice[]
  limits            BillingPlanLimit[]
  overagePrices     BillingPlanOveragePrice[]
  features          BillingPlanFeature[]
  subscriptions     AgencySubscription[]
}

model BillingPlanPrice {
  id         String        @id @default(uuid())
  planId     String
  period     BillingPeriod
  currency   String        @default("COP")
  amount     Decimal       @db.Decimal(14, 2)
  validFrom  DateTime      @default(now())
  validUntil DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  plan       BillingPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, period, validFrom])
  @@index([validUntil])
}

model BillingPlanLimit {
  id            String        @id @default(uuid())
  planId        String
  metricCode    String
  metricLabel   String?
  behavior      LimitBehavior @default(HARD_CAP)
  includedUnits Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  plan          BillingPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, metricCode])
}

model BillingPlanOveragePrice {
  id         String      @id @default(uuid())
  planId     String
  metricCode String
  currency   String      @default("COP")
  unitPrice  Decimal     @db.Decimal(14, 6)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  plan       BillingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, metricCode])
}

model BillingPlanFeature {
  id          String      @id @default(uuid())
  planId      String
  featureCode String
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  plan        BillingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureCode])
}

model BillingCityPricing {
  id         String        @id @default(uuid())
  period     BillingPeriod
  currency   String        @default("COP")
  unitPrice  Decimal       @db.Decimal(14, 2)
  validFrom  DateTime      @default(now())
  validUntil DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([period, validFrom])
  @@index([validUntil])
}

model AgencySubscription {
  id                   String                              @id @default(uuid())
  agencyId             String
  planId               String
  status               SubscriptionLifecycleStatus         @default(ACTIVE)
  period               BillingPeriod
  collectionMode       BillingCollectionMode               @default(AUTOMATIC)
  currency             String                              @default("COP")
  isFreeTier           Boolean                             @default(false)
  planSnapshot         Json
  planUnitAmount       Decimal                             @db.Decimal(14, 2)
  cityUnitAmount       Decimal?                            @db.Decimal(14, 2)
  includedCities       Int                                 @default(1)
  overageCapAmount     Decimal?                            @db.Decimal(14, 2)
  customLimits         Json?
  customOveragePricing Json?
  cycleStartAt         DateTime
  cycleEndAt           DateTime
  trialEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean                             @default(false)
  cancelScheduledAt    DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  stripeSubscriptionId String?                             @unique
  stripePriceId        String?
  stripePlanItemId     String?
  stripeCitiesItemId   String?
  nextInvoicePreviewAt DateTime?
  metadata             Json?
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt
  agency               RealEstateAgency                    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  plan                 BillingPlan                         @relation(fields: [planId], references: [id], onDelete: Restrict)
  cities               AgencySubscriptionCity[]
  pendingChanges       BillingPendingChange[]
  limitOverrides       AgencySubscriptionLimitOverride[]
  overageOverrides     AgencySubscriptionOverageOverride[]
  usageCounters        AgencyUsageCounter[]
  usageEvents          AgencyUsageEvent[]
  invoices             BillingInvoice[]
  coupons              AgencyCoupon[]
  billingAuditLogs     BillingAuditLog[]
  webhookEvents        BillingWebhookEvent[]

  @@index([agencyId, status])
  @@index([agencyId, cycleEndAt])
  @@index([planId, period])
}

model AgencySubscriptionCity {
  id                       String                 @id @default(uuid())
  subscriptionId           String
  cityCode                 String
  cityName                 String
  status                   SubscriptionCityStatus @default(ACTIVE)
  isPrimary                Boolean                @default(false)
  applyMode                ChangeApplyMode        @default(NEXT_CYCLE)
  activeFrom               DateTime?
  activeUntil              DateTime?
  stripeSubscriptionItemId String?
  prorationInvoiceId       String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  subscription             AgencySubscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, cityCode])
  @@index([subscriptionId, status])
}

model BillingPendingChange {
  id                String                 @id @default(uuid())
  agencyId          String
  subscriptionId    String?
  changeType        SubscriptionChangeType
  applyMode         ChangeApplyMode        @default(NEXT_CYCLE)
  status            PendingChangeStatus    @default(PENDING)
  requestedByUserId String?
  approvedByUserId  String?
  reason            String?
  payload           Json
  idempotencyKey    String?                @unique
  effectiveAt       DateTime
  processedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  agency            RealEstateAgency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  subscription      AgencySubscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([agencyId, status, effectiveAt])
  @@index([subscriptionId, status])
}

model AgencySubscriptionLimitOverride {
  id              String             @id @default(uuid())
  subscriptionId  String
  metricCode      String
  behavior        LimitBehavior
  includedUnits   Int
  justification   String?
  createdByUserId String?
  effectiveFrom   DateTime           @default(now())
  effectiveUntil  DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  subscription    AgencySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, metricCode, effectiveFrom])
}

model AgencySubscriptionOverageOverride {
  id              String             @id @default(uuid())
  subscriptionId  String
  metricCode      String
  currency        String             @default("COP")
  unitPrice       Decimal            @db.Decimal(14, 6)
  justification   String?
  createdByUserId String?
  effectiveFrom   DateTime           @default(now())
  effectiveUntil  DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  subscription    AgencySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, metricCode, effectiveFrom])
}

model AgencyUsageCounter {
  id               String             @id @default(uuid())
  agencyId         String
  subscriptionId   String
  metricCode       String
  cycleStartAt     DateTime
  cycleEndAt       DateTime
  behavior         LimitBehavior
  includedUnits    Int
  consumedUnits    Int                @default(0)
  overageUnits     Int                @default(0)
  overageAmount    Decimal            @default(0) @db.Decimal(14, 2)
  overageCapAmount Decimal?           @db.Decimal(14, 2)
  capReachedAt     DateTime?
  lastRecordedAt   DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  agency           RealEstateAgency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  subscription     AgencySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  usageEvents      AgencyUsageEvent[]

  @@unique([subscriptionId, metricCode, cycleStartAt])
  @@index([agencyId, cycleStartAt, cycleEndAt])
}

model AgencyUsageEvent {
  id             String              @id @default(uuid())
  agencyId       String
  subscriptionId String
  counterId      String?
  metricCode     String
  quantity       Int                 @default(1)
  eventKey       String?             @unique
  idempotencyKey String?             @unique
  sourceType     String?
  sourceRef      String?
  actorUserId    String?
  occurredAt     DateTime
  metadata       Json?
  createdAt      DateTime            @default(now())
  agency         RealEstateAgency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  subscription   AgencySubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  counter        AgencyUsageCounter? @relation(fields: [counterId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, metricCode, occurredAt])
  @@index([agencyId, occurredAt])
}

model BillingInvoice {
  id                   String                   @id @default(uuid())
  agencyId             String
  subscriptionId       String?
  stripeInvoiceId      String                   @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  invoiceNumber        String?
  status               BillingInvoiceStatus
  currency             String                   @default("COP")
  billingReason        String?
  periodStartAt        DateTime?
  periodEndAt          DateTime?
  dueAt                DateTime?
  finalizedAt          DateTime?
  paidAt               DateTime?
  failedAt             DateTime?
  subtotalAmount       Decimal                  @default(0) @db.Decimal(14, 2)
  discountAmount       Decimal                  @default(0) @db.Decimal(14, 2)
  taxAmount            Decimal                  @default(0) @db.Decimal(14, 2)
  totalAmount          Decimal                  @default(0) @db.Decimal(14, 2)
  amountDue            Decimal                  @default(0) @db.Decimal(14, 2)
  amountPaid           Decimal                  @default(0) @db.Decimal(14, 2)
  amountRemaining      Decimal                  @default(0) @db.Decimal(14, 2)
  hostedInvoiceUrl     String?
  invoicePdfUrl        String?
  paymentIntentId      String?
  rawPayload           Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  agency               RealEstateAgency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  subscription         AgencySubscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  lineItems            BillingInvoiceLineItem[]

  @@index([agencyId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([status, dueAt])
  @@index([invoiceNumber])
}

model BillingInvoiceLineItem {
  id                  String                 @id @default(uuid())
  invoiceId           String
  stripeInvoiceLineId String?                @unique
  type                BillingInvoiceLineType
  description         String?
  metricCode          String?
  cityCode            String?
  quantity            Decimal                @default(1) @db.Decimal(14, 4)
  unitAmount          Decimal                @default(0) @db.Decimal(14, 6)
  totalAmount         Decimal                @default(0) @db.Decimal(14, 2)
  periodStartAt       DateTime?
  periodEndAt         DateTime?
  metadata            Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  invoice             BillingInvoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, type])
}

model AgencyCoupon {
  id               String              @id @default(uuid())
  agencyId         String
  subscriptionId   String?
  couponCode       String
  stripeCouponId   String?
  type             CouponType
  duration         CouponDuration
  currency         String?             @default("COP")
  percentOff       Decimal?            @db.Decimal(5, 2)
  amountOff        Decimal?            @db.Decimal(14, 2)
  maxCycles        Int?
  status           AgencyCouponStatus  @default(ACTIVE)
  startsAt         DateTime?
  endsAt           DateTime?
  appliedAt        DateTime            @default(now())
  removedAt        DateTime?
  appliedByUserId  String?
  approvedByUserId String?
  reason           String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  agency           RealEstateAgency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  subscription     AgencySubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([agencyId, status, appliedAt])
  @@index([subscriptionId, status])
}

model BillingPaymentMethod {
  id                    String                     @id @default(uuid())
  agencyId              String
  stripePaymentMethodId String                     @unique
  type                  String                     @default("card")
  brand                 String?
  last4                 String?
  expMonth              Int?
  expYear               Int?
  funding               String?
  country               String?
  status                BillingPaymentMethodStatus @default(ACTIVE)
  isDefault             Boolean                    @default(false)
  fingerprint           String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  detachedAt            DateTime?
  agency                RealEstateAgency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, isDefault])
  @@index([agencyId, status])
}

model BillingWebhookEvent {
  id             String               @id @default(uuid())
  provider       String               @default("stripe")
  eventId        String               @unique
  eventType      String
  status         BillingWebhookStatus @default(RECEIVED)
  idempotencyKey String?              @unique
  agencyId       String?
  subscriptionId String?
  payload        Json
  errorMessage   String?
  attemptCount   Int                  @default(0)
  receivedAt     DateTime             @default(now())
  processedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  agency         RealEstateAgency?    @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  subscription   AgencySubscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([provider, eventType, receivedAt])
  @@index([status, receivedAt])
  @@index([agencyId, createdAt])
}

model BillingAuditLog {
  id               String                @id @default(uuid())
  agencyId         String
  subscriptionId   String?
  actorType        BillingAuditActorType
  actorUserId      String?
  action           String
  reason           String?
  approvalRequired Boolean               @default(false)
  approvedByUserId String?
  ipAddress        String?
  userAgent        String?
  previousValue    Json?
  nextValue        Json?
  createdAt        DateTime              @default(now())
  agency           RealEstateAgency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  subscription     AgencySubscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([agencyId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([action, createdAt])
}

enum OperationType {
  SALE
  RENT
  SALE_AND_RENT
  RENT_TO_OWN
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO_APARTMENT
  COUNTRY_HOUSE
  LOT
  FARM
  COMMERCIAL_RETAIL
  OFFICE
  WAREHOUSE
  PARKING
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  IN_NEGOTIATION
  SOLD
  RENTED
  WITHDRAWN
  ARCHIVED
}

enum PortfolioStatus {
  EXTERNAL_DETECTED
  INTERNAL_PIPELINE
  INTERNAL_PORTFOLIO
}

enum PropertyVisibility {
  PRIVATE
  SHARED_NETWORK
  PUBLISHED
}

enum PropertySourceType {
  MANUAL_FORM
  PORTAL_SCRAPING
  CAPTURE_OPPORTUNITY
  BULK_IMPORT
  SIGNED_MANDATE
}

enum PublicationStatus {
  PENDING
  PUBLISHED
  PAUSED
  EXPIRED
  ERROR
}

enum CaptureOpportunityStatus {
  NEW
  ASSIGNED
  CONTACTED
  IN_NEGOTIATION
  CAPTURED
  DISCARDED
  EXPIRED
}

enum DemandStatus {
  NEW
  CONTACTED
  QUALIFIED
  IN_VISIT
  IN_NEGOTIATION
  WON
  LOST
  DISCARDED
  DORMANT
}

enum DemandLeadSource {
  PORTAL
  WEB_FORM
  REFERRAL
  DIRECT_CAPTURE
  MICROSITE
  WHATSAPP_ASSISTANT
  LANDING_PAGE
  OTHER
}

enum DemandInteractionType {
  NOTE
  CALL
  MESSAGE
}

enum DemandImportJobStatus {
  DRAFT
  VALIDATED
  COMPLETED
  FAILED
}

enum TaskType {
  FOLLOW_UP
  CALL
  EMAIL
  VISIT_PREPARATION
  DOCUMENT
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum VisitType {
  CAPTURE
  COMMERCIAL
  APPRAISAL
  CLOSING
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
