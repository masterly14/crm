  provider          String              @default("resend")
  providerMessageId String?
  idempotencyKey    String              @unique
  errorMessage      String?
  metadata          Json?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  agency            RealEstateAgency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, recipientUserId, createdAt])
  @@index([agencyId, templateKey, createdAt])
  @@index([agencyId, status, createdAt])
}

model OpsAlert {
  id               String           @id @default(uuid())
  agencyId         String?
  eventType        String
  severity         OpsAlertSeverity
  status           OpsAlertStatus   @default(NEW)
  title            String
  body             String
  payload          Json?
  fingerprint      String
  dedupeWindowEndsAt DateTime
  acknowledgedByUserId String?
  acknowledgedAt   DateTime?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  agency           RealEstateAgency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  @@index([status, severity, createdAt])
  @@index([agencyId, createdAt])
  @@index([fingerprint, createdAt])
}

model GlobalContactExclusion {
  id              String            @id @default(uuid())
  channel         ContactChannel
  normalizedValue String
  valueHash       String
  reason          String?
  source          SuppressionSource
  notes           String?
  expiresAt       DateTime?
  active          Boolean           @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([channel, valueHash])
  @@index([active, channel])
  @@index([expiresAt])
  @@index([createdAt])
}
